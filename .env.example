PORT=4173
HOST=0.0.0.0
GOOGLE_CALENDAR_ID=
FR24_API_TOKEN=
FLIGHTAWARE_AEROAPI_KEY=
# Optional NOAA overrides; defaults use the official CONUS reflectivity WMS.
# NOAA_RADAR_WMS_URL=
# NOAA_RADAR_LAYER=conus_bref_qcd

# Optional private mobile gateway: leave all blank to disable it.
# Run npm.cmd run mobile:setup to configure the family password.
# Legacy Cloudflare Access settings remain supported when auth is cloudflare.
# Tunnel service URL must be http://127.0.0.1:4174 (not 4173).
DAD_RADAR_MOBILE_AUTH=
DAD_RADAR_FAMILY_PASSWORD_HASH=
DAD_RADAR_ACCESS_TEAM=
DAD_RADAR_ACCESS_AUD=
DAD_RADAR_MOBILE_ORIGIN=
DAD_RADAR_FAMILY_EMAILS=
DAD_RADAR_MOBILE_PORT=4174
